# ─────────────────────────────────────────────────────────────────
# IVR System — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────

# ── Azure Communication Services ────────────────────────────────
ACS_CONNECTION_STRING=endpoint=https://<your-acs>.communication.azure.com/;accesskey=<key>

# ── Cosmos DB ────────────────────────────────────────────────────
COSMOS_DB_CONNECTION_STRING=AccountEndpoint=https://<your-cosmos>.documents.azure.com:443/;AccountKey=<key>

# ── Azure Blob Storage ──────────────────────────────────────────
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<storage>;AccountKey=<key>

# ── Azure Functions Storage (Azurite for local dev) ─────────────
AZURE_WEBJOBS_STORAGE=UseDevelopmentStorage=true;DevelopmentStorageProxyUri=http://azurite

# ── Callback URL (public-facing URL of the Functions container) ─
CALLBACK_BASE_URL=http://localhost:7071

# ── Azure Cognitive Services (Speech) ───────────────────────────
COGNITIVE_SERVICES_ENDPOINT=https://<region>.api.cognitive.microsoft.com/
COGNITIVE_SERVICES_KEY=<key>

# ── Azure OpenAI ────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Admin Portal — Azure AD ─────────────────────────────────────
AZURE_AD_INSTANCE=https://login.microsoftonline.com/
AZURE_AD_TENANT_ID=<your-tenant-id>
AZURE_AD_CLIENT_ID=<your-client-id>

# ── ASP.NET Core ────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ── Application Insights (optional) ─────────────────────────────
APPINSIGHTS_CONNECTION_STRING=
