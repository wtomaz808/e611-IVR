@page "/call-logs"
@using IVR.Core.Interfaces
@using IVR.Core.Models
@inject ICosmosDbService CosmosDb

<PageTitle>Call Logs — IVR Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-journal-text me-2"></i>Call Logs</h3>
    <button class="btn btn-outline-secondary">
        <i class="bi bi-download me-1"></i>Export CSV
    </button>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label small">From</label>
                <input type="date" class="form-control" @bind="_fromDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">To</label>
                <input type="date" class="form-control" @bind="_toDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Status</label>
                <select class="form-select" @bind="_filterStatus">
                    <option value="">All</option>
                    @foreach (var s in Enum.GetValues<CallStatus>())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary w-100" @onclick="LoadCallLogs">
                    <i class="bi bi-search me-1"></i>Search
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Call Logs Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Time</th>
                        <th>Caller</th>
                        <th>Called</th>
                        <th>Caller Name</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Duration</th>
                        <th>Disposition</th>
                        <th>Menu Path</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in _callLogs)
                    {
                        <tr @onclick="() => SelectCallLog(log)" role="button">
                            <td><small>@log.StartTime.ToString("MM/dd HH:mm:ss")</small></td>
                            <td><code>@log.CallerNumber</code></td>
                            <td><code>@log.CalledNumber</code></td>
                            <td>@(log.AniData?.CallerName ?? "—")</td>
                            <td>
                                @if (log.AliData != null)
                                {
                                    <small>@log.AliData.Address.City, @log.AliData.Address.State</small>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>
                                <span class="badge @GetStatusBadge(log.Status)">@log.Status</span>
                            </td>
                            <td>@(log.DurationSeconds.HasValue ? FormatDuration(log.DurationSeconds.Value) : "—")</td>
                            <td><small>@log.Disposition</small></td>
                            <td>
                                <small class="text-muted">
                                    @string.Join(" → ", log.MenuPath.Select(m => m.MenuName))
                                </small>
                            </td>
                        </tr>
                    }
                    @if (!_callLogs.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">No call logs found</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Call Detail Drawer -->
@if (_selectedLog != null)
{
    <div class="offcanvas offcanvas-end show" tabindex="-1" style="width: 500px;">
        <div class="offcanvas-header">
            <h5>Call Detail</h5>
            <button type="button" class="btn-close" @onclick="() => _selectedLog = null"></button>
        </div>
        <div class="offcanvas-body">
            <dl class="row">
                <dt class="col-5">Call ID</dt>
                <dd class="col-7"><code class="small">@_selectedLog.CallId</code></dd>

                <dt class="col-5">Caller</dt>
                <dd class="col-7"><code>@_selectedLog.CallerNumber</code></dd>

                <dt class="col-5">Called</dt>
                <dd class="col-7"><code>@_selectedLog.CalledNumber</code></dd>

                <dt class="col-5">Start Time</dt>
                <dd class="col-7">@_selectedLog.StartTime.ToString("yyyy-MM-dd HH:mm:ss UTC")</dd>

                <dt class="col-5">Duration</dt>
                <dd class="col-7">@(_selectedLog.DurationSeconds.HasValue ? FormatDuration(_selectedLog.DurationSeconds.Value) : "—")</dd>

                <dt class="col-5">Status</dt>
                <dd class="col-7"><span class="badge @GetStatusBadge(_selectedLog.Status)">@_selectedLog.Status</span></dd>

                <dt class="col-5">Disposition</dt>
                <dd class="col-7">@_selectedLog.Disposition</dd>
            </dl>

            @if (_selectedLog.AniData != null)
            {
                <h6 class="mt-3">ANI Data</h6>
                <dl class="row">
                    <dt class="col-5">Name</dt>
                    <dd class="col-7">@(_selectedLog.AniData.CallerName ?? "—")</dd>
                    <dt class="col-5">Type</dt>
                    <dd class="col-7">@_selectedLog.AniData.CallerType</dd>
                    <dt class="col-5">VIP</dt>
                    <dd class="col-7">@(_selectedLog.AniData.IsVip ? "Yes" : "No")</dd>
                </dl>
            }

            @if (_selectedLog.AliData != null)
            {
                <h6 class="mt-3">ALI Data</h6>
                <dl class="row">
                    <dt class="col-5">Address</dt>
                    <dd class="col-7">@_selectedLog.AliData.Address</dd>
                    <dt class="col-5">Type</dt>
                    <dd class="col-7">@_selectedLog.AliData.LocationType</dd>
                    <dt class="col-5">Service Area</dt>
                    <dd class="col-7">@(_selectedLog.AliData.ServiceArea ?? "—")</dd>
                </dl>
            }

            <h6 class="mt-3">Menu Path</h6>
            <ol class="list-group list-group-numbered">
                @foreach (var entry in _selectedLog.MenuPath)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div>
                            <strong>@entry.MenuName</strong>
                            @if (entry.Input != null)
                            {
                                <br /><small class="text-muted">Input: <kbd>@entry.Input</kbd></small>
                            }
                        </div>
                        <small class="text-muted">@entry.Timestamp.ToString("HH:mm:ss")</small>
                    </li>
                }
            </ol>
        </div>
    </div>
}

@code {
    private List<CallLog> _callLogs = new();
    private CallLog? _selectedLog;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-7);
    private DateTime _toDate = DateTime.UtcNow;
    private string _filterStatus = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadCallLogs();
    }

    private async Task LoadCallLogs()
    {
        _callLogs = await CosmosDb.GetCallLogsAsync(_fromDate, _toDate, 100);

        if (!string.IsNullOrEmpty(_filterStatus) && Enum.TryParse<CallStatus>(_filterStatus, out var status))
            _callLogs = _callLogs.Where(c => c.Status == status).ToList();
    }

    private void SelectCallLog(CallLog log) => _selectedLog = log;

    private static string FormatDuration(double seconds) =>
        TimeSpan.FromSeconds(seconds).ToString(@"m\:ss");

    private static string GetStatusBadge(CallStatus status) => status switch
    {
        CallStatus.InProgress => "bg-success",
        CallStatus.Completed => "bg-primary",
        CallStatus.Failed => "bg-danger",
        CallStatus.Abandoned => "bg-warning text-dark",
        CallStatus.Transferred => "bg-info",
        _ => "bg-secondary"
    };
}
