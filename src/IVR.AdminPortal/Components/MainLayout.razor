@inherits LayoutComponentBase

<div class="d-flex" style="min-height: 100vh;">
    <!-- Sidebar -->
    <nav class="bg-dark text-white p-3" style="width: 260px; min-height: 100vh;">
        <div class="mb-4">
            <h4 class="text-white"><i class="bi bi-telephone-fill me-2"></i>IVR Admin</h4>
            <small class="text-muted">Management Portal</small>
        </div>

        <hr class="border-secondary" />

        <ul class="nav flex-column">
            <li class="nav-item mb-1">
                <a class="nav-link text-white" href="/">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link text-white" href="/prompts">
                    <i class="bi bi-megaphone me-2"></i> Prompts
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link text-white" href="/call-flows">
                    <i class="bi bi-diagram-3 me-2"></i> Call Flows
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link text-white" href="/teams">
                    <i class="bi bi-people-fill me-2"></i> Team Routing
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link text-white" href="/ani-ali">
                    <i class="bi bi-person-lines-fill me-2"></i> ANI / ALI Data
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link text-white" href="/call-logs">
                    <i class="bi bi-journal-text me-2"></i> Call Logs
                </a>
            </li>

            <hr class="border-secondary" />

            <li class="nav-item mb-1">
                <a class="nav-link text-white" href="/settings/business-hours">
                    <i class="bi bi-clock me-2"></i> Business Hours
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link text-white" href="/settings">
                    <i class="bi bi-gear me-2"></i> Settings
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Content -->
    <div class="flex-grow-1">
        <!-- Top bar -->
        <header class="bg-white border-bottom px-4 py-2 d-flex justify-content-between align-items-center">
            <div></div>
            <div class="d-flex align-items-center">
                <span class="me-3">
                    <i class="bi bi-circle-fill text-success me-1" style="font-size: 0.5rem;"></i>
                    System Online
                </span>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button"
                        data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle me-1"></i> Admin
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/settings">Settings</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" href="/MicrosoftIdentity/Account/SignOut">Sign Out</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="p-4 bg-light" style="min-height: calc(100vh - 56px);">
            @Body
        </main>
    </div>
</div>
