# ─────────────────────────────────────────────────────────────────
# IVR System — Local Development Environment
# Docker Compose Configuration for Mock/Simulator Mode
# ─────────────────────────────────────────────────────────────────

# ── Azure Communication Services ────────────────────────────────
# Leave empty to use PSTN Simulator mock mode
ACS_CONNECTION_STRING=

# ── Cosmos DB ────────────────────────────────────────────────────
# Leave empty to use in-memory store with seed data
COSMOS_DB_CONNECTION_STRING=

# ── Azure Blob Storage ──────────────────────────────────────────
# Leave empty to use no-op service (TTS text-only prompts)
STORAGE_CONNECTION_STRING=

# ── Azure Functions Storage (Azurite for local dev) ─────────────
AZURE_WEBJOBS_STORAGE=UseDevelopmentStorage=true;DevelopmentStorageProxyUri=http://azurite

# ── Callback URL (Functions container on Docker network) ────────
CALLBACK_BASE_URL=http://ivr-functions:80

# ── Azure Cognitive Services (Speech) ───────────────────────────
# Optional - leave empty for local testing
COGNITIVE_SERVICES_ENDPOINT=
COGNITIVE_SERVICES_KEY=

# ── Azure OpenAI ────────────────────────────────────────────────
# Optional - leave empty for local testing (AI routing will be disabled)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Admin Portal — Azure AD ─────────────────────────────────────
# Optional for local development - authentication will be disabled
AZURE_AD_INSTANCE=https://login.microsoftonline.com/
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=

# ── ASP.NET Core ────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ── Application Insights (optional) ─────────────────────────────
APPINSIGHTS_CONNECTION_STRING=

# ── PSTN Simulator Settings ─────────────────────────────────────
# ACS_MODE options: Mock (default, no Azure needed) or Live (requires real ACS)
ACS_MODE=Mock
ACS_CALLER_NUMBER=+15555551234
