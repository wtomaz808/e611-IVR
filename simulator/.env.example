# ═══════════════════════════════════════════════════════
# PSTN Simulator — Environment Variables
# ═══════════════════════════════════════════════════════

# ─── Simulator Mode ──────────────────────────────────
# "Mock"  = Fake ACS REST API on port 8080 (no Azure needed)
# "Live"  = Real ACS SDK calls (incurs per-minute charges)
ACS_MODE=Mock

# ─── Live Mode Configuration ────────────────────────
# Required only when ACS_MODE=Live
ACS_CONNECTION_STRING=
ACS_CALLER_NUMBER=

# ─── IVR Functions Endpoint ─────────────────────────
# Local dev:  http://localhost:7071
# Docker:     http://host.docker.internal:7071
# Same net:   http://ivr-functions:80
IVR_ENDPOINT=http://host.docker.internal:7071
